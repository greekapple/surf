# Optional public basemap configuration, compiled into the frontend by Vite.
# Never put secret API keys in VITE_ variables.
# Default: OpenStreetMap standard tiles, with visible attribution and normal browser caching.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
