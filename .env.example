# Public Vite build-time settings. Never put credentials in VITE_ variables.
# Optional OpenStreetMap-compatible basemap; default values are shown.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Empty/default: browser point retrieval in development; same-origin API in production.
# on: opt into the same-origin forecast API in development too.
# off: bypass the same-origin API in both environments.
VITE_FORECAST_SERVICE=

# Optional separately hosted, fixed-station NDBC adapter. Usually leave empty:
# the bundled Worker already supplies the fixed NOAA station route in production.
VITE_NOAA_PROXY_URL=

# Server runtime only, never exposed to Vite or committed with a real value:
# REFRESH_TOKEN=<configure privately in your Worker host if required>
# BUCKET is an R2-compatible runtime binding, not a VITE_ variable or file path.
# LOCAL_PREVIEW is set only by vite.config.ts for its temporary memory cache.
