// Production on Cloudflare Workers (free plan). Deploy: npm run deploy (the lead runs it with the user's go).
{
  "name": "swello",
  "main": "worker/cloudflare.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".cf/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // T-129: every forecast source that is due is refreshed into R2 every 5 minutes (worker/cloudflare.mjs `scheduled`), so the first visit after a quiet spell reads a warm cache.
  // T-129b: re-enabled after the Codex P1 fixes (relative refresh-ahead with an hourly floor for Open-Meteo and CDIP; an 800-subrequest budget per run).
  "triggers": {"crons": ["*/5 * * * *", "17 6 * * *", "47 * * * *", "20 0-6 * * *"]},
  // Round 4A: the NDBC realtime2 archive (services/ndbc-archive.mjs). "17 6 * * *" archives the previous 3 UTC days of .spec and .data_spec for 54 buoys; "47 * * * *" (hourly) only continues the one-time 45-day backfill (a one-read no-op afterwards). Objects under archive/ndbc/, no lifecycle rule (about 110 MB a year).
  // server-captures (services/surf-capture.mjs, docs/forecast/SURF-CAPTURE.md): the same "47 * * * *" tick also writes nearshore gauge rows every hour (archive/surf-height/gauges/), NWS surf zone forecasts at 02/08/14/20 UTC (archive/surf-height/srf/) and one Hawaii SWAN slice every hour (archive/swan/). About 0.7 GB a year, about 21,000 R2 writes a month; no lifecycle rule (like the NDBC archive).
  // Round 4C: "How right we've been" for every spot (services/how-right-all.mjs). "20 0-6 * * *" captures what we show (howright/v2/shown/<UTC date>.json, about 2.2 MB a day) hourly until all 492 spots are in, then scores once. Keep 35 days of captures:
  //   npx wrangler r2 bucket lifecycle add swello-forecast-cache expire-howright-v2 howright/v2/shown/ --expire-days 35
  // T-129: the persistent forecast cache (forecast-service.mjs reads and writes forecast/v8/latest/*.json through env.BUCKET). The bucket must exist before `wrangler deploy`:
  //   npx wrangler r2 bucket create swello-forecast-cache
  //   npx wrangler r2 bucket lifecycle add swello-forecast-cache expire-archive forecast/v10/ --expire-days 5   (and the same for forecast/v8/history/)
  // How right we've been (services/how-right.mjs): one daily capture of what we showed (howright/v1/shown/, about 20 KB a day) and the scorecard. Keep 35 days of captures:
  //   npx wrangler r2 bucket lifecycle add swello-forecast-cache expire-howright howright/v1/shown/ --expire-days 35
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "swello-forecast-cache"}],
  "observability": {"enabled": true}
}
