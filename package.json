{
  "name": "surf-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/tests/*.test.ts",
    "validate": "node --experimental-strip-types docs/forecast/data/validate-surf-height.ts",
    "build:cf": "tsc --noEmit && vite build && node scripts/build-cloudflare.mjs",
    "deploy": "npm run build:cf:private && wrangler deploy",
    "build:cf:private": "tsc --noEmit && vite build && node scripts/build-cloudflare.mjs --private-site"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "maplibre-gl": "^5.24.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "pbf": "^5.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.157.0"
  }
}
