# Local dev uses the same-origin /api server (vite.config.ts) because browsers cannot call NOAA ERDDAP/NDBC directly (CORS).
VITE_FORECAST_SERVICE=on
# GFS-Wave 0.25° packed frames, published every 6 h by .github/workflows/map-frames.yml (public NOAA data, not a secret). Runs older than 18 h fall back to /api/ocean.
VITE_MAP_FRAMES_BASE=https://greekapple.github.io/surf
# Owner tools (region preview, first-run preview): on for local dev and the private deploy (package.json build:cf:private); the launch build leaves it unset.
VITE_OWNER_TOOLS=true
